;-    .-.                                                                       
;-   /'v'\   SISKIN-Builder 3.25.3 project file                                 
;-  (/uOu\)  https://github.com/Siskin-framework/Builder/                       
;-===="="=======================================================================
;-      For: https://github.com/Siskin-framework/Rebol-Blend2D                  
;-------------------------------------------------------------------------------

github: @asmjit  /v1.23
github: @blend2d /v0.21.3
;github: blend2d/blend2d-samples

version: 0.21.3 ;; clang allows only x.y.z version naming!

compiler: gcc
needs:    cmake

#if Windows? [ define: TO_WINDOWS define: _CRT_SECURE_NO_WARNINGS upx: on needs: msbuild]
#if macOS?   [ define: TO_OSX     define: HAS_BOOL]
#if Linux?   [ define: TO_LINUX ]

#if macOS? [
	sign: on
	entitlements: %Entitlements.plist
	define: DISABLE_MANUAL_TARGET_ORDER_BUILD_WARNING
]

target-x86: [
	arch: x86
	#if Windows? [ defines: [ TO_WIN32 _WIN32 ] ]
	#if Linux?   [ defines: [ TO_LINUX_X86    ] ]
	#if Windows? [ set CMAKE_ARCH: "-A Win32" ]
	#if Posix?   [ set CMAKE_ARCH: "" ]
	#if macOS?   [ set CMAKE_ARCH: "" ]
	include: %$SISKIN_INSTALL/x86/include/
]
target-x64: [
	arch: x64
	defines: [
		_FILE_OFFSET_BITS=64
		__LP64__ ; has long (integer) 64 bits
	]
	#if Windows? [ defines: [ TO_WIN32_X64 _WIN32 ] ]
	#if Linux?   [ defines: [ TO_LINUX_X64        ] ]
	#if macOS?   [ defines: [ TO_OSX_X64          ] flags: ["-arch x86_64"] ]
	#if Windows? [ set CMAKE_ARCH: "-A x64" ]
	#if Posix?   [ set CMAKE_ARCH: ""]
	#if macOS?   [ set CMAKE_ARCH: "-DCMAKE_OSX_SYSROOT=macosx -DCMAKE_OSX_ARCHITECTURES=x86_64 -DCMAKE_OSX_DEPLOYMENT_TARGET=10.9" ]
	include: %$SISKIN_INSTALL/x64/include/
]

target-arm64: [
	arch: arm64
	;flags: ["-arch arm64"]
	flags: "-target arm64-apple-darwin"
	define: _FILE_OFFSET_BITS=64
	define: __LP64__ ; has long (integer) 64 bits
	define: __arm64__
	define: TO_OSX_X64
	#if Windows? [ set CMAKE_ARCH: "-A arm64" ]
	#if Posix?   [ set CMAKE_ARCH: ""]
	#if macOS?   [ set CMAKE_ARCH: "-DCMAKE_OSX_SYSROOT=macosx -DCMAKE_OSX_ARCHITECTURES=arm64 -DCMAKE_OSX_DEPLOYMENT_TARGET=11.0" ]
	include: %$SISKIN_INSTALL/arm64/include/
]

include: %blend2d/src/

;- generate the extension header, command table and README ---------------------
;; Produces %src/gen-blend2d.h and %src/gen-blend2d.c from the declarative
;; specification, and refreshes the reference sections of %README.md from the
;; same file. The args must be a block - the generator reads the spec path as
;; `first system/script/args`.
do %make-extension.r3 [%src/blend2d.reb]

r3-extension: [
	optimize: 3
	source: %src/
	files: only [
		%blend2d.c
		%gen-blend2d.c
		%blend2d-command.c
		%blend2d-command-draw.c
		%blend2d-command-path.c
		%blend2d-command-font.c
		%blend2d-command-image.c
		%blend2d-command-info.c
		%blend2d-command-set-threads.c
		;; A scratch pad for native experiments; enable it here and in the
		;; `commands:` block of %src/blend2d.reb at the same time.
		;%blend2d-command-draw-test.c
	]
	define: ENDIAN_LITTLE
	define: BL_STATIC
	define: BLEND2D_BUILD_NO_CXX_LIB=1

	;; The extension sources are built out of the Rebol tree, so the generated
	;; header includes the amalgamated `rebol-extension.h`.
	define: REB_EXT

	cflags: -fpermissive
	flags:  shared

	#if macOS? [
		lflags:  [-dynamiclib]
		flag:    -mmacosx-version-min=10.9
	]
	#if Posix? [
		compiler: clang
		cflags: [-fPIC -pthread]
		libraries: [%pthread]

		;; Export only RX_Init/RX_Quit/RX_Call/RX_Abi. Everything else stays
		;; private to the library - which matters here, because Blend2D and
		;; asmjit are linked in statically and their names would otherwise
		;; land in the process' flat namespace, where whichever object was
		;; loaded first wins for everyone.
		;;
		;; The four entry points opt back in on their own - `RXIEXT` carries
		;; API_EXPORT (default visibility) - so only they stay visible.
		flag: "-fvisibility=hidden"
	]
	#if Windows? [
		upx: on
	]
]

cmake-spec: [
	set-env CMAKE_COMMON: [
		"-DASMJIT_DIR=$NEST_ROOT/asmjit"
		"-DCMAKE_VERBOSE_MAKEFILE=OFF"
		"-DCMAKE_BUILD_TYPE=Release"
		"-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
		"-DBLEND2D_STATIC=ON"
		"$CMAKE_ARCH"
	]
]

eggs: only [
	"Cmake static Blend2D - x86" [
		name: %cmake-b2d-x86
		:target-x86 :cmake-spec
		cmd "cmake --fresh -B $SISKIN_TEMP/blend2d-x86 -S blend2d/ $CMAKE_COMMON"
		cmd "cmake --build    $SISKIN_TEMP/blend2d-x86 --config release -j 8"
		cmd "cmake --install  $SISKIN_TEMP/blend2d-x86 --prefix $SISKIN_INSTALL/x86"
	]
	"Cmake static Blend2D - x64" [
		name: %cmake-b2d-x64
		:target-x64 :cmake-spec
		cmd "cmake --fresh -B $SISKIN_TEMP/blend2d-x64 -S blend2d/ $CMAKE_COMMON"
		cmd "cmake --build    $SISKIN_TEMP/blend2d-x64 --config release -j 8"
		cmd "cmake --install  $SISKIN_TEMP/blend2d-x64 --prefix $SISKIN_INSTALL/x64"
	]
	"Cmake static Blend2D - arm64" [
		name: %cmake-b2d-arm64
		:target-arm64 :cmake-spec
		cmd "cmake --fresh -B $SISKIN_TEMP/blend2d-arm64 -S blend2d/ $CMAKE_COMMON"
		cmd "cmake --build    $SISKIN_TEMP/blend2d-arm64 --config release -j 8"
		cmd "cmake --install  $SISKIN_TEMP/blend2d-arm64 --prefix $SISKIN_INSTALL/arm64"
	]

	#if Windows? [
		"Rebol/Blend2D extension - x86" [
			:r3-extension :target-x86
			name:       %blend2d-windows-x86
			include:    %$SISKIN_INSTALL/x86/include/
			libraries: [%$SISKIN_INSTALL/x86/lib/blend2d]
		]
		"Rebol/Blend2D extension - x64" [
			:r3-extension :target-x64
			name:       %blend2d-windows-x64
			include:    %$SISKIN_INSTALL/x64/include/
			libraries: [%$SISKIN_INSTALL/x64/lib/blend2d]
		]
	]

	#if macOS? [
		"Rebol/Blend2D extension - x64" [
			:r3-extension :target-x64
			name:       %blend2d-macos-x64
			include:    %$SISKIN_INSTALL/x64/include/
			libraries: [%c %m %stdc++ %$SISKIN_INSTALL/x64/lib/ %blend2d]
		]
		"Rebol/Blend2D extension - arm64" [
			:r3-extension :target-arm64
			name:       %blend2d-macos-arm64
			include:    %$SISKIN_INSTALL/arm64/include/
			libraries: [%c %m %stdc++ %$SISKIN_INSTALL/arm64/lib/ %blend2d]
		]
	]

	#if Linux? [
		"Rebol extension" [
			:r3-extension :target-x64
			name:       %blend2d-linux-x64
			libraries: [%c %m %stdc++ %$SISKIN_INSTALL/x64/lib/ %blend2d]
		]
	]
]